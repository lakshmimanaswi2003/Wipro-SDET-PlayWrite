//***********************************************interface and enumerations in typescript*****************************


->> interface is used to define only the decleration part.
->>enumeration is used to define a set of named constant values that is nothing but casesencitive values


interface hello{
    greet1:string;
    name:string;
    salary:number;
    role:Role;//enumerate
}
interface hello{//merging the email variable into the hello interface 
    email:string;
}
enum Role {
    associate="ASSOCIATE",
    manager="MANAGER"
}
const manager:  hello={//here we are assigning the hello interface like this because we are directly saying that the structure in the user must be equal to the interface class otherwise it will give you the error.
    greet1:"hello",
    name:"henry",
    salary:50000,
    role:Role.manager,
    email:"123@gmail.com"
}
const associate: hello={
    greet1:"hi",
    name:"mena",
    salary:40000,
    role:Role.associate,//accessing the enum values
    email:"456@gmail.com"
}
console.log(manager,associate)


