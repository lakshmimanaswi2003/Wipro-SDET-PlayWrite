//***********************************************express *****************
const express = require('express');//importing the frame work
const app = express();//express object is stored in app
const PORT = 3000;

app.get('/', (req, res) => { // GET Endpoint
    res.json({ message: 'Hello World' });
});

app.get('/:name', (req, res) => { // GET Endpoint here we can write what ever name after '/'
    const name = req.params.name;
    
    res.json({ message: `Hello ${name}` });
});

app.listen(PORT, () => console.log(`App is running on PORT:${PORT}`))



->>> here we are importing the express library
->>> required('express') is used to lode the package
->>>we are storing it in the express variable
->>> by using the express we can create servers
->> this is the port number your server will run
->>> port is like a door where the user can access the server
->>app.get() ->defines a GET API endpoint
->>'/' -> means root URL
->>req -> request object (data coming from client)
->>res -> response object (what you send back)
->>req.params -> contains all URL parameters
->>name -> gets value from URL
->> app.listen is used to start the server
->> port tells where to run
->> the function will print after the server where start