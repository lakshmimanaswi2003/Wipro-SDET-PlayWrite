//*******************************************partial********************************
 
interface User {
    id: number;
    name: string;
    email: string;
    age: number;
    address: {
        city: string;
        state: string;
        country: string;
        zip: string;
    },
    skills: Object;
}

const u1: User = {
    id: 0,
    name: "Aryan",
    email: "",
    age: 0,
    address: {
        city: "",
        state: "",
        country: "",
        zip: ""
    },
    skills: {
        java: {
            spring: "low"
        }
    }
}

function updateUser(existingUser: User, updates: Partial<Omit<User, "id">>) {// we can also write function update(exe: user, update partial<user>){}
    return { ...existingUser, ...updates }
}
const updatedUser = updateUser(u1, {email: "xyz@gmail.com", age: 23})
console.log(updatedUser);

Explination:

->>> this partial<> is used to modify the data 
->>> with out using the partial<> we have to call the whole object to modify single variable in it but by using partial we can access the required data with out calling the whole data



